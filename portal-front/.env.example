# Porta padrão do servidor de desenvolvimento do Vite
PORT=5173

# URL base da API Laravel (sem barra final)
# No Railway, utilize: https://${{portal-back.RAILWAY_PUBLIC_DOMAIN}}/api
VITE_API_URL=http://localhost:8000/api

# Client ID do Google OAuth 2.0 (Google Identity Services)
# Deve coincidir com o GOOGLE_CLIENT_ID do portal-back/.env e ter a origem autorizada no Google Cloud Console
VITE_GOOGLE_CLIENT_ID=

# Chave de API do Google com a "YouTube Data API v3" ativada (Módulo 3.2 - Videoaulas)
VITE_YOUTUBE_API_KEY=

# Chave da API do Google Books (usada no preenchimento automático de livros no acervo)
VITE_GOOGLE_BOOKS_API_KEY=

# Nota: A aba Conteúdo Web utiliza o widget oficial do Google Programmable Search Engine (cx=a4b2ccff7fbbe46ad) e não requer chave de API.
